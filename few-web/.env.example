# Local Supabase, printed by `npx supabase start`.
# These are the local demo keys, not production secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public Associates tag. It is sent to Amazon with the cart form. Leave blank until you have one.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Walmart partner cart. Leave false until Walmart approves the integration.
WALMART_ENABLED=false

# Optional Instacart recipe-page link. Off until you set both.
INSTACART_ENABLED=false
INSTACART_PAGE_URL=

# Free Gemini model for Can I eat this. Create a key at https://aistudio.google.com/apikey
# The model only matches a food to the verified list, or picks an official page. It does not decide a verdict.
GEMINI_API_KEY=

# USDA FoodData Central key for weekly nutrient totals. Create one at https://fdc.nal.usda.gov/api-key.html
# If this stays empty, the public demo key is used and may be rate limited.
USDA_FDC_API_KEY=
